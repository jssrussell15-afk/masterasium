# Copy to .env.local for `npm run dev`.
# Set the same NEXT_PUBLIC_ values in the Cloudflare build environment before `npm run deploy`.
# They are inlined into the browser bundle at build time.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. If this is set, it is used instead of the anon key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Shared secret for POST /api/digest. No email is sent.
# DIGEST_CRON_SECRET=

# production on the live Worker. Anything else, including a blank value, shows the test-mode banner.
# APP_ENV=development

# Optional Cloudflare Web Analytics site token. The beacon is omitted when this is blank.
# It is a public site token, not a secret API key. No cookie is set. Do not send names, PINs, or emails.
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
