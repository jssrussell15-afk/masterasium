# Copy to .env.local for `npm run dev`.
# Set the same NEXT_PUBLIC_ values in the Cloudflare build environment before `npm run deploy`.
# They are inlined into the browser bundle at build time.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. If this is set, it is used instead of the anon key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Shared secret for POST /api/digest. No email is sent.
# DIGEST_CRON_SECRET=
