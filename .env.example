# Copy to .env.local for `npm run dev`.
# Set the same NEXT_PUBLIC_ values in the Cloudflare build environment before `npm run deploy`.
# They are inlined into the browser bundle at build time.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. If this is set, it is used instead of the anon key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Shared secret for POST /api/digest. No email is sent.
# DIGEST_CRON_SECRET=

# Server-only. Set these as Cloudflare Worker secrets. Never use a NEXT_PUBLIC_ name.
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# XAI_API_KEY=
# XAI_MONTHLY_CAP_USD=
# ALERT_EMAIL_WEBHOOK_URL=
