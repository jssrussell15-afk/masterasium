{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masterasium",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "masterasium"
    }
  ],
  "vars": {
    "APP_ENV": "production"
  },
  "env": {
    "staging": {
      "name": "masterasium-staging",
      "vars": {
        "APP_ENV": "staging"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "masterasium-staging"
        }
      ]
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // Non-production branches run `npx wrangler preview`, which refuses to
  // start without this block. Assets and compatibility stay at the top level.
  "previews": {},
  "build": {
    "command": "node scripts/patch-opennext-preview-props.mjs && npx opennextjs-cloudflare build",
    "watch_dir": ["app", "components", "lib", "public"]
  }
}
