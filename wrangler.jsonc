{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masterasium",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "masterasium"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "build": {
    "command": "node scripts/patch-opennext-preview-props.mjs && npx opennextjs-cloudflare build",
    "watch_dir": ["app", "components", "lib", "public"]
  }
}
